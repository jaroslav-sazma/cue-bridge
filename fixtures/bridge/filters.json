{
  "description": "The phone's mirror filter: which posted notifications it mirrors to the Mac. The same filter decides the live doorbells and every active-set. The checks run in the order below and the first that matches is the reason; a notification no check matches is mirrored. Attributes left out of a case take their default. ownPackage is the launcher's package; in debug builds only, a notification of the own package on a channel whose id starts with fixtureChannelPrefix is exempt from the own-package check. The lockscreenCases resolve the lockscreen attribute the way the phone's lock screen does; a mirrored notification whose lockscreen is private goes redacted.",
  "ownPackage": "app.cue.launcher",
  "fixtureChannelPrefix": "cue.bridge.fixture.",
  "order": ["own-package", "excluded", "secret", "group-summary", "ongoing", "promoted-ongoing", "media", "not-clearable", "low-importance"],
  "attributes": {
    "pkg": "The posting package; required",
    "channel": "The notification channel id; default \"\"",
    "ongoing": "FLAG_ONGOING_EVENT; default false",
    "foregroundService": "FLAG_FOREGROUND_SERVICE, which counts as ongoing; default false",
    "groupSummary": "FLAG_GROUP_SUMMARY; default false",
    "promotedOngoing": "FLAG_PROMOTED_ONGOING, a Live Update; default false",
    "category": "Notification.category; default absent. \"transport\" is media transport",
    "mediaSession": "A MediaStyle carrying a media session; default false",
    "importance": "The ranking importance: unspecified (no ranking yet), none, min, low, default or high; default \"default\". Only none, min and low are below default",
    "clearable": "StatusBarNotification.isClearable(); default true",
    "lockscreen": "What the lock screen shows of it, resolved as in lockscreenCases: public, private (redacted) or secret (hidden); default \"public\"",
    "excluded": "The package names the user keeps off the Mac; default []",
    "debugBuild": "The phone runs a debug build; default false"
  },
  "importance": {"unspecified": -1000, "none": 0, "min": 1, "low": 2, "default": 3, "high": 4},
  "visibility": {"no-override": -1000, "secret": -1, "private": 0, "public": 1},
  "lockscreenCases": [
    {"name": "the app's default with sensitive content shown", "own": "private", "channel": "no-override", "sensitiveShown": true, "expected": "public"},
    {"name": "the app's default with sensitive content hidden", "own": "private", "channel": "no-override", "sensitiveShown": false, "expected": "private"},
    {"name": "a public notification with sensitive content hidden", "own": "public", "channel": "no-override", "sensitiveShown": false, "expected": "public"},
    {"name": "the user hides the channel's content", "own": "public", "channel": "private", "sensitiveShown": true, "expected": "private"},
    {"name": "the user shows the channel's content but hides sensitive content", "own": "private", "channel": "public", "sensitiveShown": false, "expected": "private"},
    {"name": "the user shows the channel's content", "own": "private", "channel": "public", "sensitiveShown": true, "expected": "public"},
    {"name": "the app marks it secret", "own": "secret", "channel": "no-override", "sensitiveShown": true, "expected": "secret"},
    {"name": "the user keeps the channel off the lock screen", "own": "public", "channel": "secret", "sensitiveShown": true, "expected": "secret"},
    {"name": "secret wins over the user's public channel", "own": "secret", "channel": "public", "sensitiveShown": true, "expected": "secret"}
  ],
  "cases": [
    {"name": "a plain message", "notification": {"pkg": "com.example.chat", "channel": "messages"}, "expected": "mirror"},
    {"name": "high importance", "notification": {"pkg": "com.example.chat", "importance": "high"}, "expected": "mirror"},
    {"name": "no ranking delivered yet", "notification": {"pkg": "com.example.chat", "importance": "unspecified"}, "expected": "mirror"},
    {"name": "an ordinary category", "notification": {"pkg": "com.example.mail", "category": "email"}, "expected": "mirror"},
    {"name": "a group summary", "notification": {"pkg": "com.example.chat", "groupSummary": true}, "expected": "skip", "reason": "group-summary"},
    {"name": "an ongoing notification", "notification": {"pkg": "com.example.nav", "ongoing": true, "clearable": false}, "expected": "skip", "reason": "ongoing"},
    {"name": "a dismissable foreground service", "notification": {"pkg": "com.example.sync", "foregroundService": true}, "expected": "skip", "reason": "ongoing"},
    {"name": "a Live Update that is ongoing", "notification": {"pkg": "com.example.ride", "ongoing": true, "promotedOngoing": true, "clearable": false}, "expected": "skip", "reason": "ongoing"},
    {"name": "a Live Update flag alone", "notification": {"pkg": "com.example.ride", "promotedOngoing": true}, "expected": "skip", "reason": "promoted-ongoing"},
    {"name": "media transport by category", "notification": {"pkg": "com.example.music", "category": "transport"}, "expected": "skip", "reason": "media"},
    {"name": "a MediaStyle with a session", "notification": {"pkg": "com.example.music", "mediaSession": true}, "expected": "skip", "reason": "media"},
    {"name": "not clearable", "notification": {"pkg": "com.example.vpn", "clearable": false}, "expected": "skip", "reason": "not-clearable"},
    {"name": "low importance", "notification": {"pkg": "com.example.shop", "importance": "low"}, "expected": "skip", "reason": "low-importance"},
    {"name": "min importance", "notification": {"pkg": "com.example.weather", "importance": "min"}, "expected": "skip", "reason": "low-importance"},
    {"name": "no importance", "notification": {"pkg": "com.example.weather", "importance": "none"}, "expected": "skip", "reason": "low-importance"},
    {"name": "the launcher's own notification", "notification": {"pkg": "app.cue.launcher", "channel": "alerts"}, "expected": "skip", "reason": "own-package"},
    {"name": "a fixture channel in a release build", "notification": {"pkg": "app.cue.launcher", "channel": "cue.bridge.fixture.default"}, "expected": "skip", "reason": "own-package"},
    {"name": "a fixture in a debug build", "notification": {"pkg": "app.cue.launcher", "channel": "cue.bridge.fixture.default", "debugBuild": true}, "expected": "mirror"},
    {"name": "a fixture on its low-importance channel", "notification": {"pkg": "app.cue.launcher", "channel": "cue.bridge.fixture.low", "importance": "low", "debugBuild": true}, "expected": "skip", "reason": "low-importance"},
    {"name": "a fixture group summary", "notification": {"pkg": "app.cue.launcher", "channel": "cue.bridge.fixture.default", "groupSummary": true, "debugBuild": true}, "expected": "skip", "reason": "group-summary"},
    {"name": "a fixture progress notification", "notification": {"pkg": "app.cue.launcher", "channel": "cue.bridge.fixture.default", "ongoing": true, "promotedOngoing": true, "clearable": false, "debugBuild": true}, "expected": "skip", "reason": "ongoing"},
    {"name": "another channel of the own package in a debug build", "notification": {"pkg": "app.cue.launcher", "channel": "alerts", "debugBuild": true}, "expected": "skip", "reason": "own-package"},
    {"name": "another app using the fixture prefix", "notification": {"pkg": "com.example.chat", "channel": "cue.bridge.fixture.default"}, "expected": "mirror"},
    {"name": "an excluded app", "notification": {"pkg": "com.example.bank", "excluded": ["com.example.bank"]}, "expected": "skip", "reason": "excluded"},
    {"name": "another app than the excluded one", "notification": {"pkg": "com.example.chat", "excluded": ["com.example.bank"]}, "expected": "mirror"},
    {"name": "a secret notification", "notification": {"pkg": "com.example.bank", "lockscreen": "secret"}, "expected": "skip", "reason": "secret"},
    {"name": "a redacted notification is still mirrored", "notification": {"pkg": "com.example.chat", "lockscreen": "private"}, "expected": "mirror"},
    {"name": "the launcher itself even if excluded", "notification": {"pkg": "app.cue.launcher", "excluded": ["app.cue.launcher"]}, "expected": "skip", "reason": "own-package"},
    {"name": "excluded before secret", "notification": {"pkg": "com.example.bank", "lockscreen": "secret", "excluded": ["com.example.bank"]}, "expected": "skip", "reason": "excluded"},
    {"name": "secret before a group summary", "notification": {"pkg": "com.example.bank", "lockscreen": "secret", "groupSummary": true}, "expected": "skip", "reason": "secret"},
    {"name": "the own-package check comes first", "notification": {"pkg": "app.cue.launcher", "groupSummary": true, "ongoing": true}, "expected": "skip", "reason": "own-package"},
    {"name": "a summary before ongoing", "notification": {"pkg": "com.example.chat", "groupSummary": true, "ongoing": true, "clearable": false}, "expected": "skip", "reason": "group-summary"},
    {"name": "media before not clearable", "notification": {"pkg": "com.example.music", "mediaSession": true, "clearable": false}, "expected": "skip", "reason": "media"},
    {"name": "not clearable before low importance", "notification": {"pkg": "com.example.vpn", "clearable": false, "importance": "min"}, "expected": "skip", "reason": "not-clearable"}
  ]
}
